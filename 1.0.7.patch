+        if (callback) {
+            callback(createError(ERROR_CODE.ROOM_FULL, "join room failed: room is full", { roomid: roomid }), null)
+        }
+        return
+    }
+
+    try {
+        room.jion_player(player)
+        if (callback) {
+            callback(null, buildRoomResponse(room))
+        }
