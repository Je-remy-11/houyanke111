+   const _normalizeError = function(err){
+        if (!err){
+            return null
+        }
+
+        if (typeof err === "number"){
+            return {
+                code: err,
+                msg: "",
+                data: null,
+            }
+        }
+
+        if (typeof err === "string"){
+            return {
+                code: -1,
+                msg: err,
+                data: null,
+            }
+        }
+
+        return {
+            code: typeof err.code === "number" ? err.code : -1,
+            msg: err.msg || "unknown error",
+            data: err.data || null,
+        }
+   }
+
+   const _buildErrorData = function(errInfo){
+        var data = {}
+        if (errInfo.msg){
+            data.msg = errInfo.msg
+        }
+
+        if (errInfo.data && typeof errInfo.data === "object"){
+            for (var key in errInfo.data){
+                data[key] = errInfo.data[key]
+            }
+        }
+
+        if (Object.keys(data).length === 0){
+            return null
+        }
+
+        return data
+   }
+
